{
  "name": "wecom-smarttable-mcp",
  "version": "0.6.1",
  "type": "module",
  "bin": {
    "wecom-smarttable-mcp": "dist/server.js",
    "wecom-smarttable-login": "dist/login.js"
  },
  "files": [
    "dist",
    "examples",
    "SECURITY.md",
    "VALIDATION.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wecom",
    "smarttable"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/server.js",
    "login": "node dist/login.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test && npm run check:public",
    "verify:live": "node scripts/verify-live.mjs",
    "check:public": "node scripts/check-public-files.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "acorn": "8.19.0",
    "cheerio": "1.2.0",
    "file-type": "22.2.0",
    "image-size": "2.0.4",
    "playwright": "1.64.1",
    "sanitize-filename": "1.6.4",
    "tough-cookie": "6.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "description": "Read and edit WeCom smart tables, including recycle-bin deletion, using a local browser session.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyofeng/wecom-smarttable-mcp.git"
  }
}
